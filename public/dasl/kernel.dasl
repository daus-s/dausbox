use projects
use str
use math

projects = projects.projects

fn ls:
  obj Contents:
    fn _init title, lines:
      self.title = title
      self.lines = lines
  col_width = (_width - 18) // 3
  num_rows =  math.ceil projects.len // 3
  contents = []

  row_height = 0

  for project in projects:
    data = Contents project.name, str.wrap_lines project.abstract, col_width
    row_height = math.max row_height, data.lines.len

    contents = append contents, data

  msg = ""

  for i in range num_rows:
    for j in range 3:
      # print 3 projects at a time
      idx = 3 * i + j
      if idx >= contents.len:
        msg = msg + str.rep(" ", col_width + 6)
      else:
        msg = msg + " ╔═" + str.rep("═", col_width) + "═╗ "

    msg = msg + "\n"

    for j in range 3:
      idx = 3 * i + j
      if idx >= contents.len:
        msg = msg + str.rep(" ", col_width + 6)
      else:
        title = contents[idx].title
        if title.len > col_width:
            title = str.substr title, 0, col_width-3 + "..."
        else:
            while title.len < col_width:
              title = title + " "
            msg = msg + " ║ " + title + " ║ "

    msg = msg + "\n"

    for j in range 3:
      idx = 3 * i + j
      if idx >= contents.len:
        msg = msg + str.rep(" ", col_width + 6)
      else:
        msg = msg + " ╠═" + str.rep("═", col_width) + "═╣ "

    msg = msg + "\n"

    for r in range row_height:
      for j in range 3:
        idx = 3 * i + j
        if idx < contents.len:
          if r < contents[idx].lines.len:
            line = contents[idx].lines[r]
          else:
            line = str.rep(" ", col_width)
          msg = msg + " ║ " + line + " ║ "
        else:
          msg = msg + str.rep(" ", col_width + 6)

      msg = msg + "\n"

    for j in range 3:
      idx = 3 * i + j
      if idx < contents.len:
        msg = msg + " ╚═" + str.rep("═", col_width) + "═╝ "
      else:
        msg = msg + str.rep(" ", col_width + 6)

    msg = msg + "\n"

  print msg

fn whoami:
  print read "bio.txt"

fn readme project:
  print project.readme
