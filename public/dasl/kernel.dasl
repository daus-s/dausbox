use projects
use str
use math

warheads = projects.warheads
betties = projects.betties
dasl = projects.dasl
desmos = projects.desmos
optics = projects.optics

projects = projects.projects

fn ls:
  obj Contents:
    fn _init title, alias, url, lines:
      self.title = title
      self.alias = alias
      self.url = url
      self.lines = lines
  col_width = (_width - 18) // 3
  num_rows =  math.ceil projects.len / 3
  contents = []

  row_height = 0

  for project in projects:
    data = Contents project.name, project.alias, project.url, str.wrap_lines(project.abstract, col_width)
    row_height = math.max row_height, data.lines.len

    contents = append contents, data

  msg = ""

  for i in range num_rows:
    for j in range 3:
      # print 3 projects at a time
      idx = 3 * i + j
      if idx >= contents.len:
        msg = msg + str.rep(" ", col_width + 6)
      else:
        msg = msg + " ╔═" + str.rep("═", col_width) + "═╗ "

    msg = msg + "\n"

    for j in range 3:
      idx = 3 * i + j
      if idx >= contents.len:
        msg = msg + str.rep(" ", col_width + 6)
      else:
        title = contents[idx].title
        if title.len > col_width:
          title = str.substr(title, 0, col_width-3)+ "..."

        padding = ""
        while padding.len + title.len < col_width:
          padding = padding + " "

        if contents[idx].url != null:
          link = contents[idx].url
        else:
          link = ""

        title_link = "$$link:{\"link\": \"" + link + "\", \"display\": \"" + title + "\"}$$"
        msg = msg + " ║ " + title_link + padding + " ║ "

    msg = msg + "\n"


    for j in range 3:
      idx = 3 * i + j
      if idx >= contents.len:
        msg = msg + str.rep(" ", col_width + 6)
      else:
        padded_alias = "@" + contents[idx].alias + ""
        if padded_alias.len > col_width:
          padded_alias = str.substr(padded_alias, 0, col_width-3)+ "..."
        padding = ""
        while padding.len + padded_alias.len < col_width:
          padding = padding + " "

        msg = msg + " ║ " + padded_alias + padding + " ║ "

    msg = msg + "\n"

    for j in range 3:
      idx = 3 * i + j
      if idx >= contents.len:
        msg = msg + str.rep(" ", col_width + 6)
      else:
        msg = msg + " ╠═" + str.rep("═", col_width) + "═╣ "

    msg = msg + "\n"

    for r in range row_height:
      for j in range 3:
        idx = 3 * i + j
        if idx < contents.len:
          if r < contents[idx].lines.len:
            line = contents[idx].lines[r]
          else:
            line = str.rep(" ", col_width)
          msg = msg + " ║ " + line + " ║ "
        else:
          msg = msg + str.rep(" ", col_width + 6)

      msg = msg + "\n"

    for j in range 3:
      idx = 3 * i + j
      if idx < contents.len:
        msg = msg + " ╚═" + str.rep("═", col_width) + "═╝ "
      else:
        msg = msg + str.rep(" ", col_width + 6)

    msg = msg + "\n"

  info_msg = "use `open`, `github` or `readme` followed by a project named to learn more."
  padding = math.ceil((_width - info_msg.len) / 2)
  info_msg = str.rep(" ", padding) + info_msg + str.rep(" ", padding)
  msg = msg + "\n" + info_msg
  # msg = msg + str.wrap_lines("to learn more about these projects, use open to view the webpage, github to view the repo, or readme to view the projects readme", _width)
  print msg

fn whoami:
  print read "bio.txt"

fn readme project:
  print project.readme
