use warheads
use betties
use dauslang
use desmos
use optics

obj Project:
  fn _init name, abstract, url, readme, github, alias:
    self.name = name
    self.abstract = abstract
    self.url = url
    self.readme = readme
    self.git = github
    self.alias = alias

  fn _str:
    self.name + "\nurl: " + self.url + "\ngithub: " + self.git + "\n============================\n" + self.abstract + "\n============================"


warheads = Project warheads.title, warheads.abstract, warheads.url, warheads.readme, warheads.github, warheads.alias
betties = Project betties.title, betties.abstract, betties.url, betties.readme, betties.github, betties.alias
dasl = Project dauslang.title, dauslang.abstract, dauslang.url, dauslang.readme, dauslang.github, dauslang.alias
desmos = Project desmos.title, desmos.abstract, desmos.url, desmos.readme, desmos.github, desmos.alias
optics = Project optics.title, optics.abstract, optics.url, optics.readme, optics.github, optics.alias

projects = [warheads, betties, dasl, desmos, optics]
