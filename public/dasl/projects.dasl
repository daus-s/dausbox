use warheads
use betties
use dauslang

obj Project:
  fn _init name, abstract, url, readme, github:
    self.name = name
    self.abstract = abstract
    self.url = url
    self.readme = readme
    self.git = github

  fn _str:
    self.name + "\nurl: " + self.url + "\ngithub: " + self.git + "\n============================\n" + self.abstract + "\n============================"


warheads = Project warheads.title, warheads.abstract, warheads.url, warheads.readme, warheads.github
betties = Project betties.title, betties.abstract, betties.url, betties.readme, betties.github
dasl = Project dauslang.title, dauslang.abstract, dauslang.url, dauslang.readme, dauslang.github

projects = [warheads, betties, dasl]
