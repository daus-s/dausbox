use rand
use time

obj Cell:
  fn _init alive:
    self.alive = alive

obj GameOfLife:
  fn _init:
    self.h = _height - 1
    self.w = _width - 1
    grid = []
    for y in range self.h:
      row = []
      for x in range self.w:
        status = rand.next() < 0.375
        row = append row, Cell status
      grid = append grid, row
    self.grid = grid

  fn _str:
    s = ""
    for y in range self.h:
      for x in range self.w:
        if self.grid[y][x].alive:
          s = s + "▒"
        else:
          s = s + " "
      s = s + "\n"
    s = s + "press 'q' to quit."
    s

  fn neighbor_map:
    fn neighbors r, c:
      fn in_bounds r, c:
        r >= 0 and r < self.h and c >= 0 and c < self.w

      coords = [[r-1,c-1],[r-1,c],[r-1,c+1],[r,c-1],[r,c+1],[r+1,c-1],[r+1,c],[r+1,c+1]]
      valid_coords = []
      for coord in coords:
        if in_bounds(coord[0], coord[1]):
          valid_coords = append valid_coords, coord

      return valid_coords

    neighbor_map = []
    # initialize
    for y in range self.h:
      row = []
      for x in range self.w:
        row = append row, 0
      neighbor_map = append neighbor_map, row

    for y in range self.h:
      for x in range self.w:
        if self.grid[y][x].alive:
          for coord in neighbors(y,x):
            r = coord[0]
            c = coord[1]
            neighbor_map[r][c] = neighbor_map[r][c] + 1
    return neighbor_map


  fn iter:
    next = []
    neighbors = self.neighbor_map()
    for y in range self.h:
      row = []
      for x in range self.w:
        row = append row, Cell(neighbors[y][x] == 3 or self.grid[y][x].alive and neighbors[y][x] == 2)
      next = append next, row
    self.grid = next

  fn cell row, col:
    if row < 0 or row >= self.h or col < 0 or col >= self.w:
      return null
    else:
      self.grid[row][col]

fn run:
  game = GameOfLife()
  while true:
    print game
    rerender
    flush
    key = listen 500
    if key == 'q':
      break
    game.iter
  rerender
