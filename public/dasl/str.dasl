fn split s, x:
  parts = []
  token = ""
  for c in chars s:
    if c != x:
      token = token + c
    else:
      parts = append parts, token
      token  = ""
  parts = append parts, token

  parts

fn join strs, sep:
  s = ""
  first = true
  for str in strs:
    if first:
      s = s + str
      first = false
    else:
      s = s + sep + str
  s


fn chars str:
  cs = []
  for i in range str.len:
    cs = append cs, str[i]
  cs


fn wrap_lines s, width:
  final = []
  tkns = split s, " "
  line = ""
  for tkn in tkns:
    while tkn.len > width:
      final = append final, ((substr tkn, 0, width-1) + "-")
      tkn = substr tkn, width-1, tkn.len
      if tkn == null:
        break

    if line.len + tkn.len >= width: #because we need the space before
      #append and clear line
      if line.len != 0:
        while line.len < width:
            line = line + " "
        final = append final, line
      line = tkn
    else:
      if line.len == 0:
        line = tkn
      else:
        line = line + " " + tkn
  if line.len > 0:
    while line.len < width:
      line = line + " "
    final = append final, line
  return final


fn substr str, first, last:
  if first < 0 or last > str.len or first > last:
    return null

  s = ""
  for i in range first, last:
    s = s + str[i]
  s


fn rep str, n:
  s = ""
  for i in range n:
    s = s + str
  s


fn replace target, old, new:
  for i in range(target.len - old.len + 1):
    if substr(target, i, i + old.len) == old:
      return substr(target, 0, i) + new + substr(target, i + old.len, target.len)
  return target
