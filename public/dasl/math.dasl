fn sqrt x:
  if x < 0:
    return null
  else:
    return x ** 0.5


fn ln x:
  if x <= 0:
    return null
  elif 0 < x < 2:
    r = 0
    for n in range 1, 1001:
      r = r + ((1 - x) ** n / n)
    return -r
  else:
    r = 0
    for n in range 1, 101:
      r = r - (-1) ** (n - 1) / n * (1 / x - 1) ** n
    return r

fn fact x:
  r = 1
  while x > 0:
    r = r * x
    x = x - 1
  return r


fn floor x:
  r = (x % 1)
  if r != 0:
    if x < 0:
      return x - r - 1
    return x - r
  return x

fn ceil x:
  r = (x % 1)
  if r != 0:
    if x < 0:
      return x - r
    return x - r + 1
  return x


fn abs x:
  if x < 0:
    return -x
  return x

fn isprime x:
  if _type(x) != "number":
    print "WARN! math.isprime is only defined for numbers, got", _type x
    return null
  if x % 1 != 0:
    print "WARN! math.isprime is only defined for integers, got", x
    return null
  if x < 0:
    return isprime(-x)
  if x == 0 or x == 1:
    return false
  if x == 2:
    return true

  for i in range 2, ceil(sqrt(abs(x))) + 1:
      if (x % i) == 0:
        return false;
  return true


fn min a, b:
  if _type(a) != "number" or _type(b) != "number":
    print "WARN! math.min requires two numbers. got " + _type(a) + " and "+ _type(b)
    return null

  if a < b:
    return a
  else:
    return b

fn max a, b:
  if  _type(a) != "number" or _type(b) != "number":
    print "WARN! math.max requires two numbers."
    return null

  if a > b:
    return a
  else:
    return b


fn gcf a, b:
  if _type(a) != "number" or _type(b) != "number":
    print "WARN! math.gcf requires two numbers."
    return null
  if a == 0 or b == 0:
    return 0
  r = a % b
  while r != 0:
    a = b
    b = r
    r = a % b
  return b

fn lcm a, b:
  if _type(a) != "number" or _type(b) != "number":
    print "WARN! math.lcm requires two numbers."
    return null
  return a * b / gcf a, b

fn factor x:
  print PrimeFactorization x

fn sieve_of_eratosthenes n:
  if n <= 0:
    print "WARN! math.sieve_of_eratosthenes: expects a non-negative integer"
    return null

  ints = range n+1

  prime = []
  for i in ints:
    prime = append prime, true

  prime[0] = false
  prime[1] = false

  for s in ints:
    if s >= sqrt n:
      break
    if prime[s]:
      for i in range 2*s, n+1, s:
        if i != s:
          prime[i] = false

  primes = []
  for i in ints:
    if prime[i]:
      primes = append primes, i

  return primes

fn is_int n:
  _type(n) == "number" and (n % 1 == 0)

obj PrimeFactorization:
  fn _init n:
    if not is_int n:
      print "prime_factorization: only defined for integers"
      return null

    self.factors = []
    potential_factors = sieve_of_eratosthenes n

    for factor in potential_factors:
      while n % factor == 0:
        self.add_factor factor
        n = n / factor


  fn add_factor n:
    found = false
    for factor in self.factors:
      if factor.p == n:
        found = true
        factor.inc
    if not found:
      self.factors = append self.factors, Factor n

  fn _str:
    use str
    s = ""

    for factor in self.factors:
      s = s + _str factor
      s = s + "×"

    return str.substr(s, 0, s.len - 1)


obj Factor:
  fn _init p:
    self.p = p
    self.exp = 1

  fn inc:
    self.exp = self.exp + 1

  fn _str:
    exps = ["⁰", "¹", "²", "³", "⁴", "⁵", "⁶", "⁷", "⁸", "⁹"]
    s = _str self.p

    exp_str = ""
    oom = 0
    exp = self.exp

    while exp > 0:
      digit = exp % 10**(oom+1) / 10**(oom)
      exp = exp - digit * 10**(oom)
      exp_str = exps[digit] + exp_str
      oom = oom + 1

    s = s + exp_str
    return s
