use math
use test

runner = test.TestRunner()

fn within_tol actual, target, epsilon:
  (actual - target) < epsilon and (target - actual) < epsilon

epsilon = 0.00000000001

# begin tests

if within_tol math.ln(2), 0.6931471805599453, epsilon:
  runner.succeed "ln(2) passed"
else:
  runner.fail append "ln(2) failed. expected: 0.6931471805599453, got: ", math.ln 2

if within_tol math.ln(1.5), 0.4054651081, epsilon:
  runner.succeed "ln(1.5) passed"
else:
  runner.fail append "ln(1.5) failed. expected: 0.4054651081, got: ", math.ln 1.5


if math.fact(5) != 120:
  runner.fail append "factorial(5) failed, expected: 120, got: ", math.fact 5
else:
  runner.succeed "factorial(5) passed"

if math.fact(0) != 1:
  runner.fail append "factorial(0) failed, expected: 1, got: ", math.fact 0
else:
  runner.succeed "factorial(0)"


if math.ceil(5.9) != 6:
  runner.fail append "ceil(5.9) failed, expected 6, got ", math.ceil 5.9
else:
  runner.succeed "ceil(5.9)"

if math.floor(5.1) != 5:
  runner.fail append "floor(5.1) failed, expected: 5, got: ", math.floor 5.1
else:
  runner.succeed "floor(5.1)"


if math.isprime(2):
  runner.succeed "isPrime(2)"
else:
  runner.fail "Expected isPrime(2) to be true but it was false."

if math.isprime(3):
  runner.succeed "isPrime(3)"
else:
  runner.fail "Expected isPrime(3) to be true but it was false."


if math.isprime(4):
  runner.fail "Expected isPrime(4) to be false but it was true."
else:
  runner.succeed "isPrime(4)"

if math.isprime(-5):
  runner.succeed "isPrime(-5)"
else:
  runner.fail "Expected isPrime(-5) to be true but it was false."


if math.min (1,2) == 1:
  runner.succeed "min(1,2)"
elif math.min (1,2) == 2:
  runner.fail "Expected min(1,2) to be 1 but it was 2."
else:
  runner.fail "Expected min to be in the set."

if math.min (1,-2) == -2:
  runner.succeed "min(1,2)"
elif math.min (1,-2) == 1:
  runner.fail "Expected min(1,-2) to be -2 but it was 1"
else:
  runner.fail "Expected min to be in the set. " + _str math.min(1,-2)

# Test with zero values
if math.min(0,2) == 0:
  runner.succeed("min(0,2)")
else:
  runner.fail("Expected min(0,2) to be 0 but it was " + _str(math.min(0,2)))

if math.min(1,0) == 0:
  runner.succeed("min(1,0)")
else:
  runner.fail("Expected min(1,0) to be 0 but it was " + _str(math.min(1,0)))


# Test with positive values
if math.max(1,2) == 2:
  runner.succeed("max(1,2)")
else:
  runner.fail("Expected max(1,2) to be 2 but it was " + _str(math.max(1,2)))

# Test with negative values
if math.max(-1,-2) == -1:
  runner.succeed("max(-1,-2)")
else:
  runner.fail("Expected max(-1,-2) to be -1 but it was " + _str(math.max(-1,-2)))

# Test with zero
if math.max(0,2) == 2:
  runner.succeed("max(0,2)")
else:
  runner.fail("Expected max(0,2) to be 2 but it was " + _str(math.max(0,2)))

runner.report
